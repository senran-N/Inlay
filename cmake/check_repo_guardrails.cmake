cmake_minimum_required(VERSION 3.24)
if(NOT ROOT)
 get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
foreach(name LICENSE THIRD_PARTY_NOTICES.md README.md CHANGELOG.md CLAUDE.md AGENTS.md)
 if(NOT EXISTS "${ROOT}/${name}")
  message(FATAL_ERROR "${name}: required documentation missing")
 endif()
 file(SIZE "${ROOT}/${name}" size)
 if(size EQUAL 0)
  message(FATAL_ERROR "${name}: required documentation empty")
 endif()
endforeach()
file(GLOB_RECURSE public "${ROOT}/include/*.h")
foreach(path IN LISTS public)
 file(READ "${path}" content)
 if(content MATCHES "etch/src|etch_testing|<vector>|<string>|<memory>|<functional>")
  message(FATAL_ERROR "${path}: public API/private dependency rule")
 endif()
 if(path MATCHES "inlay_c.h$")
  string(REGEX MATCHALL "#[ \t]*include[^\n]+" includes "${content}")
  foreach(line IN LISTS includes)
   if(NOT line MATCHES "<(stdbool.h|stddef.h|stdint.h|etch/etch_c.h)>")
    message(FATAL_ERROR "${path}: strict C99 include rule: ${line}")
   endif()
  endforeach()
 endif()
endforeach()
file(GLOB_RECURSE examples "${ROOT}/examples/*.h" "${ROOT}/examples/*.hpp")
if(examples)
 message(FATAL_ERROR "${examples}: examples must contain zero headers")
endif()
file(GLOB_RECURSE sources "${ROOT}/src/*.cpp" "${ROOT}/src/*.h")
foreach(path IN LISTS sources)
 file(READ "${path}" content)
 if(content MATCHES "#[ \t]*include[^\n]*(etch/src|etch_testing|clay.h|stb_|harfbuzz)")
  message(FATAL_ERROR "${path}: private Etch include rule")
 endif()
 if(content MATCHES "std::(vector|string|shared_ptr|function|optional|variant|expected)|dynamic_cast[ \t]*<|typeid[ \t]*\\(")
  message(FATAL_ERROR "${path}: Orthodox C++20 rule")
 endif()
endforeach()
file(READ "${ROOT}/CMakeLists.txt" cmake)
string(REGEX MATCH "project\\(inlay VERSION ([0-9]+)\\.([0-9]+)\\.([0-9]+)" version "${cmake}")
set(major "${CMAKE_MATCH_1}")
set(minor "${CMAKE_MATCH_2}")
set(patch "${CMAKE_MATCH_3}")
file(READ "${ROOT}/include/inlay/inlay_c.h" header)
foreach(part MAJOR MINOR PATCH)
 string(TOLOWER "${part}" lower)
 if(NOT header MATCHES "INLAY_VERSION_${part} ${${lower}}([^0-9]|$)")
  message(FATAL_ERROR "include/inlay/inlay_c.h: version consistency rule (${part})")
 endif()
endforeach()
file(READ "${ROOT}/CHANGELOG.md" changelog)
if(NOT changelog MATCHES "## \\[${major}\\.${minor}\\.${patch}\\]")
 message(FATAL_ERROR "CHANGELOG.md: version heading rule")
endif()
file(READ "${ROOT}/THIRD_PARTY_NOTICES.md" notices)
file(GLOB dependencies LIST_DIRECTORIES true "${ROOT}/third_party/*")
foreach(dependency IN LISTS dependencies)
 get_filename_component(name "${dependency}" NAME)
 if(NOT name MATCHES "^\\." AND NOT notices MATCHES "third_party/${name}")
  message(FATAL_ERROR "THIRD_PARTY_NOTICES.md: missing dependency notice for third_party/${name}")
 endif()
endforeach()
message(STATUS "Inlay guardrails PASS")
