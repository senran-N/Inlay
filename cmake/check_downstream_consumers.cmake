cmake_minimum_required(VERSION 3.24)
set(work "${BINARY}/_consumer_check")
file(MAKE_DIRECTORY "${work}")
function(run)
 execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "Downstream command failed (${result}): ${ARGV}")
 endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${BINARY}" --prefix "${work}/install")
set(dependency_args "-DSDL3_DIR=${SDL3_DIR}" "-Dharfbuzz_DIR=${harfbuzz_DIR}")
if(Etch_DIR)
 list(APPEND dependency_args "-DEtch_DIR=${Etch_DIR}")
endif()
if(TOOLCHAIN)
 list(APPEND dependency_args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
if(TRIPLET)
 list(APPEND dependency_args "-DVCPKG_TARGET_TRIPLET=${TRIPLET}")
endif()
foreach(mode installed subproject)
 set(dir "${work}/${mode}")
 file(MAKE_DIRECTORY "${dir}")
 if(mode STREQUAL installed)
  set(import "find_package(Inlay 0.11 CONFIG REQUIRED)")
 else()
  set(import "set(INLAY_BUILD_TESTS OFF)\nset(INLAY_BUILD_EXAMPLES OFF)\nset(INLAY_INSTALL OFF)\nadd_subdirectory(\"${ROOT}\" inlay_build)")
 endif()
 file(WRITE "${dir}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(consumer LANGUAGES C CXX)\n${import}\nadd_executable(consumer_c \"${ROOT}/tests/consumer.c\")\nset_target_properties(consumer_c PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)\nadd_executable(consumer_cpp \"${ROOT}/tests/consumer.cpp\")\ntarget_compile_features(consumer_cpp PRIVATE cxx_std_20)\nforeach(target consumer_c consumer_cpp)\ntarget_link_libraries(\${target} PRIVATE Inlay::inlay)\nif(WIN32)\nadd_custom_command(TARGET \${target} POST_BUILD COMMAND \${CMAKE_COMMAND} -E copy_if_different $<TARGET_RUNTIME_DLLS:\${target}> $<TARGET_FILE_DIR:\${target}> COMMAND_EXPAND_LISTS)\nendif()\nendforeach()\n")
 run("${CMAKE_COMMAND}" -S "${dir}" -B "${dir}/build" -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${work}/install" ${dependency_args})
 run("${CMAKE_COMMAND}" --build "${dir}/build")
 foreach(language c cpp)
  run("${dir}/build/consumer_${language}${EXE_SUFFIX}")
 endforeach()
endforeach()
